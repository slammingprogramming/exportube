# Copy this file to .env and fill in the values you need.
# tune-history loads .env automatically via python-dotenv-style parsing in config.py.

# --- YouTube Data API (OAuth) ---
# Only needed for Method A (account-based acquisition) for the parts of the
# pipeline that the official API *does* support (video/channel metadata
# lookups, "liked videos" and playlist enumeration). The Data API v3 does
# NOT expose watch history; see docs/YOUTUBE_AUTH.md.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Desktop app") and download the client secret JSON.
TUNE_HISTORY_GOOGLE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
TUNE_HISTORY_GOOGLE_TOKEN_STORE=./secrets/token.json

# --- Browser-session watch-history acquisition (Method A fallback) ---
# yt-dlp can read cookies from an installed browser to fetch
# https://www.youtube.com/feed/history on your behalf, because the Data API
# cannot. Set which browser to pull cookies from, e.g. chrome, firefox, edge,
# brave, vivaldi. Leave blank to disable and require Takeout import instead.
TUNE_HISTORY_COOKIES_FROM_BROWSER=

# Alternative: point at a Netscape-format cookies.txt file exported manually.
TUNE_HISTORY_COOKIES_FILE=

# --- MusicBrainz ---
# MusicBrainz requires a descriptive User-Agent with contact info for
# unauthenticated, rate-limited (1 req/sec) access. No API key needed.
TUNE_HISTORY_MUSICBRAINZ_APP=tune-history
TUNE_HISTORY_MUSICBRAINZ_VERSION=0.1.0
TUNE_HISTORY_MUSICBRAINZ_CONTACT=you@example.com

# --- Discogs (optional, second metadata_enrichment provider) ---
# Metadata-only, like MusicBrainz -- no audio is downloaded or sent.
# Get a free personal access token at
# https://www.discogs.com/settings/developers ("Generate new token").
# Leave blank to run identification on MusicBrainz alone (the default);
# setting this only adds Discogs as a second, independent source that can
# corroborate or supply a candidate MusicBrainz missed.
TUNE_HISTORY_DISCOGS_TOKEN=

# --- AcoustID (not implemented -- audio fingerprinting requires
# downloading audio, which this metadata-only pipeline deliberately does
# not do; see AGENTS.md "Known limitations". Left here as a placeholder
# in case that trade-off is revisited.) ---
TUNE_HISTORY_ACOUSTID_API_KEY=

# --- Storage / cache ---
TUNE_HISTORY_DATA_DIR=./data
TUNE_HISTORY_DB_PATH=./data/tune_history.sqlite3

# --- Logging ---
TUNE_HISTORY_LOG_LEVEL=INFO
